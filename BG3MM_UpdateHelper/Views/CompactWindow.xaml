<Window x:Class="BG3MM_UpdateHelper.Views.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BG3MM_UpdateHelper.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        AllowDrop="True"
        SizeToContent="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#DDDDDD"/>
            <Setter Property="FontFamily"      Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"        Value="22"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border: rounded + drop shadow -->
    <Border CornerRadius="16"
            Background="#FF2D2D30"
            Opacity="{Binding CompactOpacity}"
            Width="{Binding CompactSize}"
            Height="{Binding CompactSize}">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Check for Updates"  Command="{Binding CheckUpdatesCommand}"/>
                <MenuItem Header="Launch BG3MM"       Command="{Binding LaunchBG3MMCommand}"/>
                <Separator/>
                <MenuItem Header="Download History"   Command="{Binding OpenHistoryCommand}"/>
                <MenuItem Header="Settings"           Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Exit Compact Mode"  Command="{Binding ExitCompactCommand}"/>
                <MenuItem Header="Exit"               Command="{Binding ExitAppCommand}"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.45" ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <Border CornerRadius="16" ClipToBounds="True">
            <Grid>
                <!-- 2×2 icon button grid -->
                <UniformGrid Rows="2" Columns="2" Margin="16">
                    <Button Style="{StaticResource CompactButton}"
                            Content="&#xE72C;"
                            Command="{Binding CheckUpdatesCommand}"
                            ToolTip="Check for Updates"
                            MaxWidth="52" MaxHeight="52" Margin="6"/>

                    <Button Style="{StaticResource CompactButton}"
                            Content="&#xE700;"
                            Command="{Binding LaunchBG3MMCommand}"
                            ToolTip="Launch BG3MM"
                            MaxWidth="52" MaxHeight="52" Margin="6"/>

                    <Button Style="{StaticResource CompactButton}"
                            Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings"
                            MaxWidth="52" MaxHeight="52" Margin="6"/>

                    <Button Style="{StaticResource CompactButton}"
                            Content="&#xE923;"
                            Command="{Binding ExitCompactCommand}"
                            ToolTip="Exit Compact Mode"
                            MaxWidth="52" MaxHeight="52" Margin="6"/>
                </UniformGrid>

                <!-- Scanning indicator -->
                <Border VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="●"
                               FontSize="8"
                               Foreground="#0078d4">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.8"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Border>

                <!-- Drag overlay -->
                <Grid x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle Fill="#CC1a1a2e"/>
                    <Border BorderBrush="#4da6ff" BorderThickness="2" Margin="3">
                        <TextBlock Text="&#x2B07;"
                                   FontSize="48" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
