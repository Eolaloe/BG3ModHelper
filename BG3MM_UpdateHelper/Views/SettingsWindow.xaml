<Window x:Class="BG3MM_UpdateHelper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Unified width for all action buttons in Settings (Change, Get API Key, Apply) -->
        <Style x:Key="SettingsActionButton" TargetType="Button">
            <Setter Property="Width"   Value="80"/>
            <Setter Property="Padding" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <GroupBox Header="Paths" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/bg3mm.ico"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="BG3MM Folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="BG3MMPathBox" IsReadOnly="True"
                                     Padding="4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Style="{StaticResource SettingsActionButton}"
                                    Click="BrowseBG3MM_Click"/>
                        </Grid>
                        <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                            <Run Text="Don't have BG3MM? "/>
                            <Hyperlink NavigateUri="https://github.com/LaughingLeader/BG3ModManager/releases/latest"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="Download here."/>
                            </Hyperlink>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/bg3.png"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Mods Folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ModsPathBox" IsReadOnly="True"
                                     Padding="4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Style="{StaticResource SettingsActionButton}"
                                    Click="BrowseMods_Click"/>
                        </Grid>
                        <TextBlock Text="Leave as default unless your BG3 data is in a non-standard location."
                                   Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- API Keys -->
                <GroupBox Header="API Keys" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <!-- Nexus Mods + Free/Premium badge -->
                        <Grid Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/nexus.png"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Nexus Mods" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="NexusTierBadge" CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="NexusTierText" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="NexusLoginBtn" Content="Nexus Login"
                                    Style="{StaticResource SettingsActionButton}"
                                    HorizontalAlignment="Right"
                                    Click="NexusLogin_Click"
                                    ToolTip="Log in / out of Nexus Mods"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Masked -->
                            <PasswordBox Grid.Column="0" x:Name="NexusKeyBox"
                                         Padding="4" VerticalContentAlignment="Center"
                                         PasswordChar="*"/>
                            <!-- Plain text (visible when eye is toggled) -->
                            <TextBox Grid.Column="0" x:Name="NexusKeyBoxPlain"
                                     Padding="4" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁" Width="30" Margin="4,0,0,0"
                                    FontSize="13" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ToggleNexusKey_Click"
                                    ToolTip="Show / Hide"/>
                            <Button Grid.Column="2" Content="Get API Key" Margin="4,0,0,0" Style="{StaticResource SettingsActionButton}"
                                    Click="OpenNexusKeyPage_Click"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Image Source="pack://application:,,,/modio.png"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center" Margin="0,0,5,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="mod.io" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0" x:Name="ModioKeyBox"
                                         Padding="4" VerticalContentAlignment="Center"
                                         PasswordChar="*"/>
                            <TextBox Grid.Column="0" x:Name="ModioKeyBoxPlain"
                                     Padding="4" Visibility="Collapsed"/>
                            <Button Grid.Column="1" Content="👁" Width="30" Margin="4,0,0,0"
                                    FontSize="13" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ToggleModioKey_Click"
                                    ToolTip="Show / Hide"/>
                            <Button Grid.Column="2" Content="Get API Key" Margin="4,0,0,0" Style="{StaticResource SettingsActionButton}"
                                    Click="OpenModioKeyPage_Click"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="#888888" FontSize="11" Margin="0,8,0,0">
                            <Run Text="API keys are stored in plain text at:"/>
                            <LineBreak/>
                            <Hyperlink x:Name="ApiKeyFolderLink"
                                       RequestNavigate="ApiKeyFile_RequestNavigate">
                                <Run x:Name="ApiKeyFolderText"/>
                            </Hyperlink>
                            <LineBreak/>
                            <Run Text="Do not share your settings.json or expose your API keys publicly."/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Options -->
                <GroupBox Header="Options" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="BackupCheckBox"
                                  Content="Create .pak.bak backup before overwriting a mod"
                                  Margin="0,4"/>

                        <CheckBox x:Name="FolderWatchCheckBox"
                                  Content="Auto-install from download folder"
                                  Margin="0,12,0,8"
                                  Click="FolderWatch_Checked"/>

                        <!-- Watch folder path — always accessible -->
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="Watch Folder" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="#555555"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WatchFolderBox"
                                         IsReadOnly="True" Padding="4"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Style="{StaticResource SettingsActionButton}"
                                        Click="BrowseWatchFolder_Click"/>
                            </Grid>
                            <TextBlock Text="Only newly created archive files are monitored while the app is running."
                                       Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="DeleteSourceCheckBox"
                                  Content="Move source archive/pak to Recycle Bin after successful install"
                                  Margin="0,12,0,0"/>
                        <TextBlock Text="Applies to folder-watch auto-install and drag-and-drop."
                                   Foreground="#888888" FontSize="11" Margin="20,2,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Compact Mode opacity -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Compact Mode Opacity"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider Grid.Column="1" x:Name="CompactOpacitySlider"
                                    Minimum="0.3" Maximum="1.0"
                                    SmallChange="0.05" LargeChange="0.1"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="CompactOpacitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Value, ElementName=CompactOpacitySlider, StringFormat={}{0:P0}}"
                                       FontSize="11" Foreground="#555555"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- nxm:// Protocol Handler -->
                <GroupBox Header="Mod Manager Download Links (nxm://)" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="NxmEnabledCheckBox"
                                  Content="Use this app as the primary nxm:// handler"
                                  Checked="NxmEnabledCheckBox_Changed"
                                  Unchecked="NxmEnabledCheckBox_Changed"/>
                        <TextBlock Text="BG3 nxm links go to the Primary handler. Non-BG3 links forward to Secondary."
                                   Foreground="#888888" FontSize="11" Margin="20,2,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Primary + Secondary one-line -->
                        <Grid x:Name="NxmControlPanel" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Primary:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="PrimaryHandlerCombo" Grid.Column="1"
                                      SelectionChanged="HandlerCombo_SelectionChanged"/>

                            <TextBlock Grid.Column="3" Text="Secondary:" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SecondaryHandlerCombo" Grid.Column="4"
                                      SelectionChanged="HandlerCombo_SelectionChanged"/>

                            <Button x:Name="ApplyHandlerButton" Grid.Column="6"
                                    Content="Apply" Style="{StaticResource SettingsActionButton}"
                                    Click="ApplyHandlerButton_Click"
                                    IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- About -->
                <GroupBox Header="About">
                    <StackPanel Margin="8">
                        <TextBlock>
                            <Run Text="Version: " FontWeight="SemiBold"/>
                            <Run x:Name="VersionRun"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Developed by " FontWeight="SemiBold"/>
                            <Run Text="Eolaloe"/>
                            <Run Text=" — "/>
                            <Hyperlink NavigateUri="https://www.nexusmods.com/profile/Eolaloe"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="Nexus"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Data folder: " FontWeight="SemiBold"/>
                            <Hyperlink x:Name="DataFolderLink"
                                       RequestNavigate="DataFolder_RequestNavigate">
                                <Run x:Name="DataFolderText"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="100" Height="32" Margin="0,0,8,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="100" Height="32"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
