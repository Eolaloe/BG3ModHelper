<Window x:Class="BG3MM_UpdateHelper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        MaxHeight="900"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

                <GroupBox Header="Paths" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <TextBlock Text="BG3MM Folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="BG3MMPathBox" IsReadOnly="True"
                                     Padding="4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Padding="12,4"
                                    Click="BrowseBG3MM_Click"/>
                        </Grid>
                        <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                            <Run Text="Don't have BG3MM? "/>
                            <Hyperlink NavigateUri="https://github.com/LaughingLeader/BG3ModManager/releases/latest"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="Download here."/>
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Text="Mods Folder" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ModsPathBox" IsReadOnly="True"
                                     Padding="4" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Padding="12,4"
                                    Click="BrowseMods_Click"/>
                        </Grid>
                        <TextBlock Text="Leave as default unless your BG3 data is in a non-standard location."
                                   Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- API Keys -->
                <GroupBox Header="API Keys" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <!-- Nexus Mods + Free/Premium badge -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                            <TextBlock Text="Nexus Mods" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border x:Name="NexusTierBadge" CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="NexusTierText" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="NexusKeyBox" Padding="4"/>
                            <Button Grid.Column="1" Content="Get API Key" Margin="6,0,0,0" Padding="12,4"
                                    Click="OpenNexusKeyPage_Click"/>
                        </Grid>

                        <TextBlock Text="mod.io" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ModioKeyBox" Padding="4"/>
                            <Button Grid.Column="1" Content="Get API Key" Margin="6,0,0,0" Padding="12,4"
                                    Click="OpenModioKeyPage_Click"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Foreground="#888888" FontSize="11" Margin="0,8,0,0">
                            <Run Text="API keys are stored in plain text at:"/>
                            <LineBreak/>
                            <Hyperlink x:Name="ApiKeyFolderLink"
                                       RequestNavigate="ApiKeyFile_RequestNavigate">
                                <Run x:Name="ApiKeyFolderText"/>
                            </Hyperlink>
                            <LineBreak/>
                            <Run Text="Do not share your settings.json or expose your API keys publicly."/>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Options -->
                <GroupBox Header="Options" Margin="0,0,0,12">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="BackupCheckBox"
                                  Content="Create .pak.bak backup before overwriting a mod"
                                  Margin="0,4"/>

                        <CheckBox x:Name="FolderWatchCheckBox"
                                  Content="Auto-install from download folder"
                                  Margin="0,12,0,8"
                                  Click="FolderWatch_Checked"/>

                        <!-- Watch folder path — always accessible -->
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="Watch Folder" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="#555555"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="WatchFolderBox"
                                         IsReadOnly="True" Padding="4"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Change..." Margin="6,0,0,0" Padding="12,4"
                                        Click="BrowseWatchFolder_Click"/>
                            </Grid>
                            <TextBlock Text="Only newly created archive files are monitored while the app is running."
                                       Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- About -->
                <GroupBox Header="About">
                    <StackPanel Margin="8">
                        <TextBlock>
                            <Run Text="Version: " FontWeight="SemiBold"/>
                            <Run Text="0.9.0"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Developed by " FontWeight="SemiBold"/>
                            <Run Text="Eolaloe"/>
                            <Run Text=" — "/>
                            <Hyperlink NavigateUri="https://www.nexusmods.com/profile/Eolaloe"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="Nexus"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0">
                            <Run Text="Data folder: " FontWeight="SemiBold"/>
                            <Hyperlink x:Name="DataFolderLink"
                                       RequestNavigate="DataFolder_RequestNavigate">
                                <Run x:Name="DataFolderText"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="100" Height="32" Margin="0,0,8,0"
                    IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="100" Height="32"
                    IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
