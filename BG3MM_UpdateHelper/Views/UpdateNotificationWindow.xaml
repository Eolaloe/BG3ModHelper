<Window x:Class="BG3MM_UpdateHelper.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BG3MM_UpdateHelper.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding TitleText}"
        Width="800" Height="900"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#106ebe"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#555555"/>
        </Style>

        <Style x:Key="RegisterActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#888888"/>
        </Style>

        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#f0f0f0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModNameButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UpdateEntryViewModel}">
            <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding CanBeQueued}"/>
                        <Button Grid.Column="1"
                                ToolTip="{Binding ActivePageUrl}"
                                Style="{StaticResource ModNameButton}"
                                Command="{Binding OpenPageCommand}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PlatformModName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasPlatformName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding LocalModName}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Foreground" Value="#222222"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPlatformName}" Value="True">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="#888888"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentVersion}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas" FontSize="11" Foreground="#444444"
                                   Margin="0,0,2,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="→"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="#888888"/>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding NewVersionDisplay}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   FontFamily="Consolas" FontSize="11" Foreground="#444444"
                                   Margin="2,0,0,0"/>
                        <Grid Grid.Column="5">
                            <Border MinWidth="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="3" Padding="4,1">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding SourceBadgeColor}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding SourceBadge}"
                                           Foreground="White" FontSize="10" FontWeight="SemiBold"
                                           TextAlignment="Center"/>
                            </Border>
                            <Button Content="⇄"
                                    Style="{StaticResource SwitchButton}"
                                    Command="{Binding ToggleSourceCommand}"
                                    Visibility="{Binding HasMultipleSources, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="22" Margin="0,0,2,0"
                                    ToolTip="Switch source"/>
                        </Grid>
                        <Button Grid.Column="6"
                                Content="{Binding ActionLabel}"
                                Style="{Binding ActionStyle, Converter={StaticResource StyleKeyConverter}}"
                                Command="{Binding PrimaryActionCommand}"
                                IsEnabled="{Binding IsActionEnabled}"
                                Width="70"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7"
                                   Text="{Binding StatusText}"
                                   Foreground="{Binding StatusColor}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="11"/>
                    </Grid>
                    <StackPanel Margin="30,6,0,2"
                                Visibility="{Binding ShowNexusRegisterPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Paste the Nexus mod page URL to link it. This will be shared with the community."
                                   FontSize="11" Foreground="#666666" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NexusUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" Margin="0,0,6,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Link"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding RegisterNexusCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Root: left panel + expandable WebView panel side by side -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="720"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left panel (existing layout) ── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,16,0">
                        <Button x:Name="NexusLoginBtn"
                                Width="48" Height="48"
                                Padding="0" Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                Click="NexusLogin_Click"
                                ToolTip="Nexus Login">
                            <Image x:Name="NexusLoginIcon" Width="44" Height="44"
                                   Source="pack://application:,,,/nexus_grey.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Nexus Premium + ↗ = clickable link -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Tag="https://www.nexusmods.com/games/baldursgate3"
                                    Click="ExternalLink_Click"
                                    ToolTip="Open Nexus BG3 mods">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Nexus Premium" FontSize="11" FontWeight="SemiBold" Foreground="#d98200" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ↗" FontSize="10" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="— auto-download" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                            <!-- Nexus Free: plain text, no link -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Nexus Free" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="— opens mod page" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                            <!-- mod.io + ↗ = clickable link -->
                            <Button Grid.Row="4" Grid.Column="0"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Tag="https://mod.io/g/baldursgate3"
                                    Click="ExternalLink_Click"
                                    ToolTip="Open mod.io BG3 mods">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="mod.io" FontSize="11" FontWeight="SemiBold" Foreground="#0078d4" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ↗" FontSize="10" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="— auto-download" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#f0f0f0" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,5,25,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="75"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            Command="{Binding SortByNameCommand}">
                        <TextBlock Text="{Binding NameSortHeader}" Style="{StaticResource ColHeader}"/>
                    </Button>
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="3" Text="Version" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                    <Button Grid.Column="5" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            Command="{Binding SortBySourceCommand}">
                        <TextBlock Text="{Binding SourceSortHeader}" Style="{StaticResource ColHeader}"/>
                    </Button>
                    <TextBlock Grid.Column="6" Text="Action" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="Status" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding EntriesView}"/>
            </ScrollViewer>

            <Border Grid.Row="3" Padding="16,6" Background="#fff8e1" BorderBrush="#ffe082" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="#555500"/>
            </Border>

            <Border Grid.Row="4" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Select All"   Command="{Binding SelectAllCommand}"   Padding="10,5" Margin="0,0,8,0"/>
                        <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Padding="10,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="Download Selected"
                                Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding DownloadSelectedCommand}"
                                Height="32" MinWidth="150" FontSize="13" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Close" Command="{Binding CloseCommand}" Padding="16,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Right panel: Nexus WebView slide (initially collapsed) ── -->
        <Grid x:Name="WebViewPanel" Grid.Column="1" Width="700"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" Background="#f0f0f0"
                    BorderBrush="#e0e0e0" BorderThickness="1,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WebViewStatusText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Click 'Mod Manager Download' on Nexus to continue."
                                   FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" x:Name="ZoomOutBtn"
                                Width="22" Height="22" Padding="0"
                                FontSize="13" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="ZoomOut_Click"/>
                        <TextBlock x:Name="WebViewZoomText" Text="100%"
                                   FontSize="11" Foreground="#555555"
                                   VerticalAlignment="Center"
                                   MinWidth="36" TextAlignment="Center"
                                   Margin="4,0"/>
                        <Button Content="+" x:Name="ZoomInBtn"
                                Width="22" Height="22" Padding="0"
                                FontSize="13" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="ZoomIn_Click" Margin="0,0,10,0"/>
                        <Button Content="⏭  Skip"
                                Command="{Binding SkipCommand}"
                                Padding="10,4"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding IsSkipVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="✕  Close"
                                Command="{Binding CloseWebViewCommand}"
                                Padding="10,4"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="1,0,0,0">
                <wv2:WebView2 x:Name="NexusWebView"/>
            </Border>
        </Grid>
    </Grid>
</Window>
