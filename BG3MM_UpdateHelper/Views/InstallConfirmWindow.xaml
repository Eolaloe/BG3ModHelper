<Window x:Class="BG3MM_UpdateHelper.Views.InstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BG3MM_UpdateHelper.Views"
        Title="New Mod Detected"
        SizeToContent="Height"
        Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"   Value="#555555"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="Height"       Value="20"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f0f0f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header text -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Source badge + switch + mod name -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Required: source selection buttons -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>  <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Header text + queue display -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding HeaderText}"
                       TextWrapping="Wrap"
                       Foreground="#444444"
                       FontSize="13"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding QueueDisplay}"
                       Foreground="#888888" FontSize="11"
                       VerticalAlignment="Top"
                       Margin="8,2,0,0"/>
        </Grid>

        <!-- Source badge + ⇄ switch button + mod name -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                    MinWidth="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush Color="{Binding BadgeColor}"/>
                </Border.Background>
                <TextBlock Text="{Binding BadgeText}"
                           Foreground="White"
                           FontSize="10" FontWeight="SemiBold"
                           TextAlignment="Center"/>
            </Border>
            <!-- ⇄ switch button — visible only for Both+Estimated -->
            <Button Content="⇄"
                    Style="{StaticResource SwitchButton}"
                    Command="{Binding SwitchCommand}"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding CanSwitch}"
                    ToolTip="Switch source"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ModName}"
                           FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="260"/>
                <TextBlock Text="{Binding ModVersion}"
                           FontSize="11" Foreground="#888888"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Required: Nexus / mod.io source selection -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    Visibility="{Binding IsRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center">
            <Button Content="Nexus"
                    Width="120" Height="32" Margin="0,0,12,0"
                    Click="NexusButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#e0e0e0"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NexusSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#d98200"/>
                                <Setter Property="Background" Value="#fff3e0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="mod.io"
                    Width="120" Height="32"
                    Click="ModioButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#e0e0e0"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModioSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#1a7fd4"/>
                                <Setter Property="Background" Value="#e3f2fd"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Action buttons — 4 equal-width buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Ignore All"
                    Height="30" FontSize="12"
                    IsEnabled="{Binding ShowQueueInfo}"
                    Command="{Binding IgnoreAllCommand}"
                    ToolTip="{Binding QueueTooltip}"/>

            <Button Grid.Column="2" Content="Install All"
                    Height="30" FontSize="12"
                    IsEnabled="{Binding ShowQueueInfo}"
                    Command="{Binding InstallAllCommand}"
                    ToolTip="{Binding QueueTooltip}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Background"   Value="#0078d4"/>
                                <Setter Property="Foreground"   Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="4" Content="Ignore"
                    Height="30" FontSize="12"
                    Command="{Binding IgnoreCommand}"
                    IsCancel="True"/>

            <Button Grid.Column="6" Content="Install"
                    Height="30" FontSize="12"
                    Command="{Binding InstallCommand}"
                    IsDefault="True"
                    Background="#0078d4" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
