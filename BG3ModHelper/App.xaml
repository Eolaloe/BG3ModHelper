<Application x:Class="BG3ModHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BG3ModHelper.Views">
    <Application.Resources>
        <views:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <views:InverseBoolConverter             x:Key="InverseBoolConverter"/>
        <views:StyleKeyConverter                x:Key="StyleKeyConverter"/>

        <!-- ── Source badge: shared across all windows ── -->
        <Style x:Key="SourceBadgeBorder" TargetType="Border">
            <Setter Property="MinWidth"            Value="46"/>
            <Setter Property="CornerRadius"        Value="3"/>
            <Setter Property="Padding"             Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="SourceBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ── Action button styles: shared across update windows ── -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background"          Value="#0078d4"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Padding"             Value="12,4"/>
            <Setter Property="MinWidth"            Value="90"/>
            <Setter Property="Height"              Value="26"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#106ebe"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SecondaryActionButton intentionally NOT in App.xaml:
             StyleKeyConverter falls back to default WPF button style when key not found.
             This preserves the original appearance of Identify / Open Page action buttons. -->

        <Style x:Key="RegisterActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#888888"/>
        </Style>

        <Style x:Key="StopActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background"          Value="#c42b2b"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Padding"             Value="12,4"/>
            <Setter Property="MinWidth"            Value="90"/>
            <Setter Property="Height"              Value="26"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#a32020"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModNameButton" TargetType="Button">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="Padding"                 Value="0"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
