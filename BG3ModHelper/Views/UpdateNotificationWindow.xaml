<Window x:Class="BG3ModHelper.Views.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BG3ModHelper.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding TitleText}"
        Width="850" Height="1150"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#106ebe"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#555555"/>
        </Style>

        <Style x:Key="RegisterActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#888888"/>
        </Style>

        <Style x:Key="StopActionButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#c42b2b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#a32020"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#cccccc"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#f0f0f0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModNameButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UpdateEntryViewModel}">
            <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreserved}" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>  <!-- source -->
                            <ColumnDefinition Width="100"/>  <!-- action -->
                            <ColumnDefinition Width="85"/>   <!-- status -->
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding CanBeQueued}"/>
                        <Button Grid.Column="1"
                                ToolTip="{Binding ActivePageUrl}"
                                Style="{StaticResource ModNameButton}"
                                Command="{Binding OpenPageCommand}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PlatformModName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasPlatformName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Left"
                                            Content="{Binding ExpandIcon}"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding HasGroupChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="0,0,4,0" Margin="0,0,2,0"
                                            FontSize="9" Cursor="Hand" Focusable="False"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LocalModName}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Foreground" Value="#222222"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPlatformName}" Value="True">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="Foreground" Value="#888888"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Button>
                        <!-- Lock button (col 2) -->
                        <Button Grid.Column="2"
                                Content="🔒"
                                Foreground="{Binding PreserveLockColor}"
                                Command="{Binding TogglePreserveCommand}"
                                Background="Transparent" BorderThickness="0"
                                Width="20" Padding="0" FontSize="12"
                                Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="{Binding PreserveLockTooltip}"
                                ToolTipService.InitialShowDelay="400"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding CurrentVersion}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas" FontSize="11" Foreground="#444444"
                                   Margin="0,0,2,0"/>
                        <TextBlock Grid.Column="4"
                                   Text="→"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="#888888"/>
                        <TextBlock Grid.Column="5"
                                   Text="{Binding NewVersionDisplay}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   FontFamily="Consolas" FontSize="11" Foreground="#444444"
                                   Margin="2,0,0,0"/>
                        <Grid Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- Single source: normal badge -->
                            <Border Style="{StaticResource SourceBadgeBorder}"
                                    Background="{Binding SourceBadgeColor}"
                                    Visibility="{Binding HasMultipleSources, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding SourceBadge}" Style="{StaticResource SourceBadgeText}"/>
                            </Border>

                            <!-- Multiple sources: stacked badge — entire area clickable to switch -->
                            <!-- Each badge: MinWidth=46, Padding=4,1 (matches single badge)
                                 Back offset 16px right + 6px down → front covers ~65% of back -->
                            <Button Visibility="{Binding HasMultipleSources, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding ToggleSourceCommand}"
                                    Padding="0" Cursor="Hand"
                                    ToolTip="Click to switch source">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!-- Grid: back badge(46px) offset 16px right+6px down, front group = badge+⇄ -->
                                        <Grid Width="66" Height="26">
                                            <!-- Back badge: inactive, peeking bottom-right — moves down 2px on hover -->
                                            <Border x:Name="BackBadge"
                                                    Panel.ZIndex="0"
                                                    Style="{StaticResource SourceBadgeBorder}"
                                                    Margin="16,6,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{Binding BackSourceBadgeColor}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform/>
                                                </Border.RenderTransform>
                                                <TextBlock Text="{Binding BackSourceBadge}"
                                                           Style="{StaticResource SourceBadgeText}"/>
                                            </Border>
                                            <!-- Front badge + ⇄ as one group — moves up 2px on hover together -->
                                            <StackPanel x:Name="FrontGroup"
                                                        Panel.ZIndex="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform/>
                                                </StackPanel.RenderTransform>
                                                <Border Style="{StaticResource SourceBadgeBorder}"
                                                        Background="{Binding SourceBadgeColor}">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               Style="{StaticResource SourceBadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="FrontGroup"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                To="-2" Duration="0:0:0.1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="BackBadge"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                To="2" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="FrontGroup"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                To="0" Duration="0:0:0.1"/>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="BackBadge"
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                To="0" Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>
                        <Button Grid.Column="7"
                                Content="{Binding ActionLabel}"
                                Style="{Binding ActionStyle, Converter={StaticResource StyleKeyConverter}}"
                                Command="{Binding PrimaryActionCommand}"
                                IsEnabled="{Binding IsActionButtonEnabled}"
                                Width="70"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="200"
                                ToolTipService.ShowDuration="30000"
                                ToolTipService.Placement="Left">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="640">
                                    <TextBlock Text="{Binding Changelog}"
                                               TextWrapping="Wrap"
                                               FontSize="11"/>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                        <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusProgress}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="9" HorizontalAlignment="Center"
                                       Visibility="{Binding HasStatusProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Group children (expanded pak list) -->
                    <ItemsControl ItemsSource="{Binding GroupChildren}"
                                  Margin="38,3,0,2"
                                  Visibility="{Binding IsGroupExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LocalModName}"
                                               FontSize="11" Foreground="#666666"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               Foreground="{Binding StatusColor}"
                                               FontSize="11" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="30,6,0,2"
                                Visibility="{Binding ShowNexusRegisterPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Paste the Nexus mod page URL to link it. This will be shared with the community."
                                   FontSize="11" Foreground="#666666" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NexusUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="4,3" FontSize="11" Margin="0,0,6,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Link"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding RegisterNexusCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Root: left panel + expandable WebView panel side by side -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="720"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left panel (existing layout) ── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,16,0">
                        <Button x:Name="NexusLoginBtn"
                                Width="48" Height="48"
                                Padding="0" Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                Click="NexusLogin_Click"
                                ToolTip="Nexus Login">
                            <Image x:Name="NexusLoginIcon" Width="44" Height="44"
                                   Source="pack://application:,,,/Assets/nexus_grey.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Nexus Premium + ↗ = clickable link -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Tag="https://www.nexusmods.com/games/baldursgate3"
                                    Click="ExternalLink_Click"
                                    ToolTip="Open Nexus BG3 mods">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Nexus Premium" FontSize="11" FontWeight="SemiBold" Foreground="#d98200" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ↗" FontSize="10" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="— auto-download" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                            <!-- Nexus Free: plain text, no link -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Nexus Free" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="— opens mod page" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                            <!-- mod.io + ↗ = clickable link -->
                            <Button Grid.Row="4" Grid.Column="0"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Tag="https://mod.io/g/baldursgate3"
                                    Click="ExternalLink_Click"
                                    ToolTip="Open mod.io BG3 mods">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="mod.io" FontSize="11" FontWeight="SemiBold" Foreground="#0078d4" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ↗" FontSize="10" Foreground="#aaaaaa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="— auto-download" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column header template (shared style) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Active section ── -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- section label + select-all -->
                        <RowDefinition Height="Auto"/>  <!-- column headers -->
                        <RowDefinition Height="*"/>     <!-- list -->
                    </Grid.RowDefinitions>

                    <!-- Section label: pastel orange accent for Active -->
                    <Border Grid.Row="0" Background="#fff8ee" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#e8924a"/>
                            <TextBlock Text="{Binding ActiveSectionHeader}"
                                       Margin="8,4,0,4"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Column headers with master checkbox -->
                    <Border x:Name="ActiveHeaderBorder"
                            Grid.Row="1" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,6,25,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <!-- Master select-all checkbox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding ActiveMasterChecked, Mode=TwoWay}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortActiveByNameCommand}">
                                <TextBlock Text="{Binding ActiveNameSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <Button Grid.Column="2" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortActiveByLockCommand}">
                                <TextBlock Text="{Binding ActiveLockSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="Version"
                                       Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <Button Grid.Column="6" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortActiveBySourceCommand}">
                                <TextBlock Text="{Binding ActiveSourceSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <TextBlock Grid.Column="7" Text="Action" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Status" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ActiveScroller"
                                  Grid.Row="2" VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding ActiveEntriesView}"/>
                    </ScrollViewer>
                </Grid>

                <!-- ── Inactive section ── -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- section label + select-all -->
                        <RowDefinition Height="Auto"/>  <!-- column headers -->
                        <RowDefinition Height="*"/>     <!-- list -->
                    </Grid.RowDefinitions>

                    <!-- Section label: pastel blue accent for Inactive -->
                    <Border Grid.Row="0" Background="#eef4ff" BorderBrush="#e0e0e0" BorderThickness="0,1,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#5b9bd5"/>
                            <TextBlock Text="{Binding InactiveSectionHeader}"
                                       Margin="8,4,0,4"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Column headers with master checkbox -->
                    <Border x:Name="InactiveHeaderBorder"
                            Grid.Row="1" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,6,25,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <!-- Master select-all checkbox -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding InactiveMasterChecked, Mode=TwoWay}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortInactiveByNameCommand}">
                                <TextBlock Text="{Binding InactiveNameSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <Button Grid.Column="2" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortInactiveByLockCommand}">
                                <TextBlock Text="{Binding InactiveLockSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="Version"
                                       Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <Button Grid.Column="6" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortInactiveBySourceCommand}">
                                <TextBlock Text="{Binding InactiveSourceSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <TextBlock Grid.Column="7" Text="Action" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Status" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="InactiveScroller"
                                  Grid.Row="2" VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding InactiveEntriesView}"/>
                    </ScrollViewer>
                </Grid>

                <!-- ── Sync Recommended section ── -->
                <Grid Grid.Row="2"
                      Visibility="{Binding HasSyncEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- section label -->
                        <RowDefinition Height="Auto"/>  <!-- column headers -->
                        <RowDefinition Height="Auto"/>  <!-- list (capped height) -->
                    </Grid.RowDefinitions>

                    <!-- Section label: amber accent for Sync -->
                    <Border Grid.Row="0" Background="#fffde7" BorderBrush="#e0e0e0" BorderThickness="0,1,0,1">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#f5b400"/>
                            <StackPanel Orientation="Horizontal" Margin="8,4,0,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SyncSectionHeader}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#444444"/>
                                <TextBlock Text="  —  Version scheme mismatch detected · re-download once to enable accurate tracking"
                                           FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Column headers with master checkbox -->
                    <Border Grid.Row="1" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,6,25,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding SyncMasterChecked, Mode=TwoWay}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                    Command="{Binding SortSyncByNameCommand}">
                                <TextBlock Text="{Binding SyncNameSortHeader}" Style="{StaticResource ColHeader}"/>
                            </Button>
                            <TextBlock Grid.Column="2" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"
                                       Text="{Binding SyncLockSortHeader}"/>
                            <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="Version"
                                       Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="Source"  Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="Action"  Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Status"  Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="SyncScroller"
                                  Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding SyncEntriesView}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Padding="16,6" Background="#fff8e1" BorderBrush="#ffe082" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="#555500"/>
            </Border>

            <Border Grid.Row="4" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="Download Selected"
                                Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding DownloadSelectedCommand}"
                                Height="32" MinWidth="150" FontSize="13" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Close" Command="{Binding CloseCommand}" Padding="16,5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Right panel: Nexus WebView slide (initially collapsed) ── -->
        <Grid x:Name="WebViewPanel" Grid.Column="1" Width="700"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" Background="#f0f0f0"
                    BorderBrush="#e0e0e0" BorderThickness="1,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WebViewStatusText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Click 'Mod Manager Download' on Nexus to continue."
                                   FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−" x:Name="ZoomOutBtn"
                                Width="22" Height="22" Padding="0"
                                FontSize="13" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="ZoomOut_Click"/>
                        <TextBlock x:Name="WebViewZoomText" Text="100%"
                                   FontSize="11" Foreground="#555555"
                                   VerticalAlignment="Center"
                                   MinWidth="36" TextAlignment="Center"
                                   Margin="4,0"/>
                        <Button Content="+" x:Name="ZoomInBtn"
                                Width="22" Height="22" Padding="0"
                                FontSize="13" Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="ZoomIn_Click" Margin="0,0,10,0"/>
                        <Button Content="⏭  Skip"
                                Command="{Binding SkipCommand}"
                                Padding="10,4"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding IsSkipVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="✕  Close"
                                Command="{Binding CloseWebViewCommand}"
                                Padding="10,4"
                                Cursor="Hand"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="1,0,0,0">
                <wv2:WebView2 x:Name="NexusWebView"/>
            </Border>
        </Grid>
    </Grid>
</Window>
