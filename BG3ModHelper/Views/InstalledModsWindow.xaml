<Window x:Class="BG3ModHelper.Views.InstalledModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BG3ModHelper.ViewModels"
        Title="Installed Mods"
        Width="850" Height="1000"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- SourceBadge style lives in App.xaml as SourceBadgeBorder (global) -->

        <!-- Transparent link button matching NexusLinkButton style -->
        <Style x:Key="ModPageLinkButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="#0078d4"
                                   TextDecorations="Underline"
                                   HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Foreground" Value="#005a9e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tb" Property="TextDecorations" Value="{x:Null}"/>
                                <Setter TargetName="tb" Property="Foreground"      Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared ListBox item container style (no selection visuals) -->
        <Style x:Key="NoSelectItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared DataTemplate for both active and unactivated ListBoxes -->
        <DataTemplate DataType="{x:Type vm:InstalledModEntryViewModel}">
            <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- name + pak -->
                        <ColumnDefinition Width="110"/>  <!-- author -->
                        <ColumnDefinition Width="100"/>  <!-- version -->
                        <ColumnDefinition Width="90"/>   <!-- source badges -->
                        <ColumnDefinition Width="80"/>   <!-- links -->
                    </Grid.ColumnDefinitions>

                    <!-- name (top) + pak filename (bottom) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ModName}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ModName}"/>
                        <TextBlock Text="{Binding PakFile}"
                                   FontSize="11" Foreground="#888888"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PakFile}"/>
                    </StackPanel>

                    <!-- author -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Author}"
                               FontSize="11" Foreground="#555555"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Author}"
                               Margin="0,0,4,0"/>

                    <!-- version: meta version only; Nexus file name available via tooltip -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding MetaVersion}"
                               FontFamily="Consolas" FontSize="11" Foreground="#444444"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               ToolTip="{Binding VersionTooltip}"
                               ToolTipService.InitialShowDelay="300"/>

                    <!-- source: Nexus / mod.io / Unlink / Others badges -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Style="{StaticResource SourceBadgeBorder}" Background="#d98200"
                                Visibility="{Binding HasNexus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nexus" Style="{StaticResource SourceBadgeText}"/>
                        </Border>
                        <Border Style="{StaticResource SourceBadgeBorder}" Background="#1a7fd4"
                                Margin="0,2,0,0"
                                Visibility="{Binding HasModio, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="mod.io" Style="{StaticResource SourceBadgeText}"/>
                        </Border>
                        <!-- Unlink: in community DB but UUID not matched yet -->
                        <Border Style="{StaticResource SourceBadgeBorder}" Background="#b85450"
                                Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVis}}"
                                ToolTip="This mod appears in the community database but could not be matched automatically. Click 'Link' to assign a Nexus mod ID manually.">
                            <TextBlock Text="Unlink" Style="{StaticResource SourceBadgeText}"/>
                        </Border>
                        <!-- Others: truly unknown (not in DB) -->
                        <Border Style="{StaticResource SourceBadgeBorder}" Background="#888888"
                                Visibility="{Binding IsOthers, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Others" Style="{StaticResource SourceBadgeText}"/>
                        </Border>
                    </StackPanel>

                    <!-- links: Nexus ID / mod.io handle / Link button -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Nexus ID: when manually linked, show ID + small ✎ edit button -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasNexus, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center">
                            <Button Content="{Binding NexusIdDisplay}"
                                    Command="{Binding OpenNexusCommand}"
                                    IsEnabled="{Binding CanOpenNexus}"
                                    Style="{StaticResource ModPageLinkButton}"/>
                            <Button Content="✎"
                                    Command="{Binding EditLinkCommand}"
                                    Visibility="{Binding IsManuallyLinked, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="3,0,0,0" Margin="2,0,0,0"
                                    FontSize="10" Foreground="#888888" Cursor="Hand"
                                    ToolTip="Edit or remove this manual link"/>
                        </StackPanel>
                        <Button Content="{Binding ModioHandleDisplay}"
                                Command="{Binding OpenModioCommand}"
                                IsEnabled="{Binding CanOpenModio}"
                                Style="{StaticResource ModPageLinkButton}"
                                Visibility="{Binding HasModio, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"/>
                        <!-- Link button for Unlink mods -->
                        <Button Content="🔗"
                                Command="{Binding OpenLinkDialogCommand}"
                                Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                Padding="6,2" FontSize="12"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Assign a Nexus mod ID manually"/>
                        <!-- Others: Link button or external URL -->
                        <StackPanel Visibility="{Binding IsOthers, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center">
                            <!-- External URL: clickable link + edit button -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasExternalLink, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center">
                                <Button Content="🔗"
                                        Command="{Binding OpenExternalCommand}"
                                        Style="{StaticResource ModPageLinkButton}"
                                        FontSize="12"
                                        ToolTip="{Binding ExternalUrlDisplay}"/>
                                <Button Content="✎"
                                        Command="{Binding EditLinkCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="3,0,0,0" Margin="2,0,0,0"
                                        FontSize="10" Foreground="#888888" Cursor="Hand"
                                        ToolTip="Edit or remove this external link"/>
                            </StackPanel>
                            <!-- No link: show 🔗 button -->
                            <Button Content="🔗"
                                    Command="{Binding OpenLinkDialogCommand}"
                                    Visibility="{Binding HasExternalLink, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    Padding="6,2" FontSize="12"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Link to Nexus, mod.io, or any external page"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Reusable column-header row template (used for both active and unactivated) -->
        <Style x:Key="SectionColHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush"     Value="#e0e0e0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Background"      Value="#f8f8f8"/>
            <Setter Property="Padding"         Value="8,5,25,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- active + inactive sections -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}"      FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HeaderCountLine}"  FontSize="12" Foreground="#666666" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HeaderSourceLine}" FontSize="12" Foreground="#888888" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main content: Active (top 2/3) + Inactive (bottom 1/3) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>  <!-- active section -->
                <RowDefinition Height="*"/>   <!-- inactive section -->
            </Grid.RowDefinitions>

            <!-- ── Active section: label → column headers → list ── -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- section label -->
                    <RowDefinition Height="Auto"/>  <!-- column headers -->
                    <RowDefinition Height="*"/>     <!-- list -->
                </Grid.RowDefinitions>

                <!-- Active section label: pastel orange accent -->
                <Border Grid.Row="0" Background="#fff8ee" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" Background="#e8924a"/>
                        <TextBlock Text="{Binding ActiveHeader}"
                                   Margin="8,4,0,4"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Active column headers -->
                <Border Grid.Row="1" Style="{StaticResource SectionColHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleNameSortCommand}">
                            <TextBlock Text="{Binding NameHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <Button Grid.Column="1"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleAuthorSortCommand}">
                            <TextBlock Text="{Binding AuthorHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3"
                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleSourceSortCommand}">
                            <TextBlock Text="{Binding SourceHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <Button Grid.Column="4"
                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleLinkSortCommand}">
                            <TextBlock Text="{Binding LinkHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Active ListBox -->
                <Border Grid.Row="2" BorderBrush="#e0e0e0" BorderThickness="1,0,1,1">
                    <ListBox ItemsSource="{Binding ActiveEntries}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NoSelectItem}"/>
                </Border>
            </Grid>

            <!-- ── Inactive section: label → column headers → list ── -->
            <Grid Grid.Row="1"
                  Visibility="{Binding HasInactive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- section label -->
                    <RowDefinition Height="Auto"/>  <!-- column headers -->
                    <RowDefinition Height="*"/>     <!-- list -->
                </Grid.RowDefinitions>

                <!-- Inactive section label: pastel blue accent -->
                <Border Grid.Row="0" Background="#eef4ff" BorderBrush="#e0e0e0" BorderThickness="0,1,0,1">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" Background="#5b9bd5"/>
                        <TextBlock Text="{Binding InactiveHeader}"
                                   Margin="8,4,0,4"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Inactive column headers -->
                <Border Grid.Row="1" Style="{StaticResource SectionColHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleInactiveNameSortCommand}">
                            <TextBlock Text="{Binding InactiveNameHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <Button Grid.Column="1"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleInactiveAuthorSortCommand}">
                            <TextBlock Text="{Binding InactiveAuthorHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <TextBlock Grid.Column="2" Text="Version" Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                        <Button Grid.Column="3"
                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleInactiveSourceSortCommand}">
                            <TextBlock Text="{Binding InactiveSourceHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                        <Button Grid.Column="4"
                                HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                Command="{Binding ToggleInactiveLinkSortCommand}">
                            <TextBlock Text="{Binding InactiveLinkHeaderText}" Style="{StaticResource ColHeader}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Inactive ListBox -->
                <Border Grid.Row="2" BorderBrush="#e0e0e0" BorderThickness="1,0,1,1">
                    <ListBox ItemsSource="{Binding InactiveEntries}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NoSelectItem}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- footer: Reset Order (left) + Close (right) -->
        <Grid Grid.Row="2" Margin="16,8,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Reset Sort"
                    Width="90" Height="28"
                    Command="{Binding ResetSortCommand}"/>

            <Button Grid.Column="2" Content="Close" Width="90" Height="28"
                    IsDefault="True" IsCancel="True"
                    Command="{Binding CloseCommand}"/>
        </Grid>
    </Grid>
</Window>
