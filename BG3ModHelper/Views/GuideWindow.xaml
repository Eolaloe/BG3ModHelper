<Window x:Class="BG3ModHelper.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BG3 Mod Helper — Guide"
        Width="620" Height="620"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GuidePanel"
                        TextBlock.FontFamily="Segoe UI"
                        TextBlock.FontSize="13"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Translate"
                    Width="80" Padding="0,5" Margin="0,0,8,0"
                    Click="Translate_Click"/>
            <Button Content="Close"
                    Width="80" Padding="0,5"
                    IsDefault="True" IsCancel="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
