<Window x:Class="BG3ModHelper.Views.ModTroubleshootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod Troubleshooter"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#888888" FontSize="11" Margin="0,0,0,14">
            Shows mods with local tracking records. Select one to clear its stored data
            (links, file IDs, download history) without touching the .pak file itself.
        </TextBlock>

        <!-- Search row (TextBox + placeholder overlay) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox"
                     Padding="4" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="Mod name, author, pak filename, Nexus URL, or mod ID…"
                       Foreground="#AAAAAA" FontStyle="Italic"
                       Padding="6,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False"/></Grid>

        <!-- Results list + no-results overlay (always occupies same space) -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <ListBox x:Name="ResultsList"
                     Height="160"
                     SelectionChanged="ResultsList_SelectionChanged"/>
            <TextBlock x:Name="NoResultsText"
                       Visibility="Hidden"
                       Foreground="#888888" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Text="No mods found matching that query."/>
        </Grid>

        <!-- Preview -->
        <Border Grid.Row="3" x:Name="PreviewBorder"
                Visibility="Hidden"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                Margin="0,0,0,12">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="11"/>
        </Border>

        <!-- Action row -->
        <Grid Grid.Row="4">
            <Button x:Name="ClearAllBtn"
                    Content="Clear All Records…"
                    HorizontalAlignment="Left"
                    Padding="12,4"
                    Click="ClearAllBtn_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ClearBtn"
                        Content="Clear Records for Selected Mod"
                        Padding="12,4" Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="ClearBtn_Click"
                        ToolTip="Remove local records for the selected mod. The .pak file will not be deleted."/>
                <Button Content="Close"
                        Width="70" Padding="0,4"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
