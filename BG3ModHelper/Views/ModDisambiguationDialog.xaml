<Window x:Class="BG3ModHelper.Views.ModDisambiguationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Mod" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CandidateItem" TargetType="RadioButton">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#e0e0e0"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Margin"          Value="0,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078d4"/>
                                <Setter TargetName="bd" Property="Background"  Value="#eff6ff"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#f5f5f5"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background"  Value="#dbeafe"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Multiple mods match this pak file."
                   FontSize="13" FontWeight="SemiBold" Foreground="#222222"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="SubtitleText"
                   FontSize="11" Foreground="#666666"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel x:Name="CandidatePanel" Margin="0,0,0,10"/>

        <!-- Report guide -->
        <Border Background="#fff8f0" BorderBrush="#f0c080" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#995500"
                           TextWrapping="Wrap" Margin="0,0,0,4">
                    If you suspect a mod is an unauthorized reupload, please report it. Cleaner listings benefit everyone.
                </TextBlock>
                <TextBlock FontSize="11" Foreground="#555555" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">🚩 How to report  </Run>
                    <Run>Use the</Run>
                    <Run FontWeight="SemiBold"> 🚩 </Run>
                    <Run>button on the suspected entry, then on Nexus follow these steps:</Run>
                </TextBlock>
                <Grid Margin="4,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1. " FontSize="11" Foreground="#777777" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,1,0,1">
                        Reason → <Run FontWeight="SemiBold">"I believe this mod is breaking the rules"</Run>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2. " FontSize="11" Foreground="#777777" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,1,0,1">
                        Which rule → <Run FontWeight="SemiBold">"Stolen Content"</Run>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3. " FontSize="11" Foreground="#777777" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,1,0,1">
                        Are you the owner? → <Run FontWeight="SemiBold">Yes</Run> (if you're the author) / <Run FontWeight="SemiBold">No</Run> (otherwise)
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="4. " FontSize="11" Foreground="#777777" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,1,0,1">
                        Original content hosted → <Run FontWeight="SemiBold">"Nexus Mods"</Run>
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="5. " FontSize="11" Foreground="#777777" Margin="0,1,4,1"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="#444444" TextWrapping="Wrap" Margin="0,1,0,1">
                        Source Link → use <Run FontWeight="SemiBold">📋</Run> on the <Run FontStyle="Italic">original</Run> entry above to copy its page URL, then paste
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="6. " FontSize="11" Foreground="#777777"
                               Margin="0,2,4,1" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,1,0,2">
                        <TextBlock FontSize="11" Foreground="#444444" TextWrapping="Wrap">
                            Additional details → e.g.
                        </TextBlock>
                        <!-- Clickable chip: copies the suggested text to clipboard -->
                        <Border x:Name="CopyDetailsChip"
                                Background="#f5f0e8" BorderBrush="#d4c4a8" BorderThickness="1"
                                CornerRadius="3" Padding="6,3" Margin="0,3,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="CopyDetailsChip_Click"
                                ToolTip="Click to copy to clipboard">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#ede4d4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock x:Name="CopyDetailsIcon" DockPanel.Dock="Left"
                                           Text="📋" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Top"/>
                                <TextBlock FontStyle="Italic" FontSize="11" Foreground="#666666" TextWrapping="Wrap">
                                    "Unauthorized reupload. Redistributed without the original author's permission."
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Width="80" Padding="0,5" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmBtn"
                    Content="Confirm"
                    Width="80" Padding="0,5"
                    Click="Confirm_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
