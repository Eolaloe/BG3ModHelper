<Window x:Class="BG3ModHelper.Views.ModIdentifiedListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BG3ModHelper.ViewModels"
        Title="Identified Mods" Width="760"
        SizeToContent="Height" MaxHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Section 1: mods in the current update list (same as update window minus lock + action cols) ── -->
        <DataTemplate DataType="{x:Type vm:UpdateEntryViewModel}">
            <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,5"
                    Background="{Binding RowBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>   <!-- author -->
                        <ColumnDefinition Width="160"/>  <!-- nexus mod / file -->
                        <ColumnDefinition Width="100"/>  <!-- source -->
                        <ColumnDefinition Width="100"/>  <!-- status/change -->
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding CanBeQueued}"/>

                    <Button Grid.Column="1"
                            ToolTip="{Binding ActivePageUrl}"
                            Style="{StaticResource ModNameButton}"
                            Command="{Binding OpenPageCommand}"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PlatformModName}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasPlatformName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding LocalModName}"
                                       FontSize="13" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#222222"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlatformName}" Value="True">
                                                <Setter Property="FontSize"   Value="11"/>
                                                <Setter Property="Foreground" Value="#888888"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Column="2"
                               Text="{Binding LocalAuthor}"
                               VerticalAlignment="Center" FontSize="11" Foreground="#666666"
                               TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>

                    <!-- Nexus Mod name (top) + Nexus File name (bottom) -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="{Binding NexusModName}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#222222"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NexusModName}"/>
                        <TextBlock Text="{Binding NexusFileName}"
                                   FontSize="11" Foreground="#aaaaaa"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding NexusFileName}"/>
                    </StackPanel>

                    <!-- Source badge -->
                    <Grid Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Style="{StaticResource SourceBadgeBorder}"
                                Background="{Binding SourceBadgeColor}"
                                Visibility="{Binding HasMultipleSources, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SourceBadge}" Style="{StaticResource SourceBadgeText}"/>
                        </Border>
                        <Button Visibility="{Binding HasMultipleSources, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding ToggleSourceCommand}"
                                Padding="0" Cursor="Hand" ToolTip="Click to switch source">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="66" Height="26">
                                        <Border x:Name="BackBadge" Panel.ZIndex="0"
                                                Style="{StaticResource SourceBadgeBorder}"
                                                Margin="16,6,0,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{Binding BackSourceBadgeColor}">
                                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                                            <TextBlock Text="{Binding BackSourceBadge}" Style="{StaticResource SourceBadgeText}"/>
                                        </Border>
                                        <StackPanel x:Name="FrontGroup" Panel.ZIndex="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                                            <Border Style="{StaticResource SourceBadgeBorder}"
                                                    Background="{Binding SourceBadgeColor}">
                                                <TextBlock Text="{Binding SourceBadge}" Style="{StaticResource SourceBadgeText}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="FrontGroup"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="-2" Duration="0:0:0.1"/>
                                                        <DoubleAnimation Storyboard.TargetName="BackBadge"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="2" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="FrontGroup"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="0" Duration="0:0:0.1"/>
                                                        <DoubleAnimation Storyboard.TargetName="BackBadge"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                            To="0" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Status / Change button -->
                    <Grid Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center"
                                    Visibility="{Binding ShowChangeButton, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusProgress}"
                                       Foreground="{Binding StatusColor}"
                                       FontSize="9" HorizontalAlignment="Center"
                                       Visibility="{Binding HasStatusProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <Button Content="Change"
                                Command="{Binding ChangeIdentificationCommand}"
                                Visibility="{Binding ShowChangeButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="70"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- description -->
            <RowDefinition Height="Auto"/>   <!-- column headers -->
            <RowDefinition Height="*" MaxHeight="580"/>  <!-- list -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
        </Grid.RowDefinitions>

        <!-- Description -->
        <Border Grid.Row="0" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="16,10">
            <TextBlock FontSize="11" Foreground="#666666" TextWrapping="Wrap">
                Mods that have been manually linked to a specific Nexus entry.
                Click Change to reassign if the identification is wrong.
            </TextBlock>
        </Border>

        <!-- Column headers -->
        <Border x:Name="HeaderBorder"
                Grid.Row="1" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1"
                Padding="8,6,25,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="✓"           Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Name"        Style="{StaticResource ColHeader}"/>
                <TextBlock Grid.Column="2" Text="Author"      Style="{StaticResource ColHeader}"/>
                <TextBlock Grid.Column="3" Text="Nexus Mod / File" Style="{StaticResource ColHeader}"/>
                <TextBlock Grid.Column="4" Text="Source"      Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Status"      Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer x:Name="ListScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Section 1: mods in the current update list -->
                <ItemsControl x:Name="UpdateListEntries"/>

                <!-- Section 2 header: linked but not in update list (hidden when empty) -->
                <Border x:Name="LinkedOnlyHeader"
                        Background="#eef4ff" BorderBrush="#e0e0e0" BorderThickness="0,1,0,1"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" Background="#5b9bd5"/>
                        <TextBlock Margin="8,4,0,4"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#444444" VerticalAlignment="Center"
                                   Text="Linked — not in current update list"/>
                    </DockPanel>
                </Border>

                <!-- Section 2: IdentifiedLinkEntryViewModel rows -->
                <ItemsControl x:Name="LinkedOnlyEntries">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:IdentifiedLinkEntryViewModel}">
                            <Border BorderBrush="#e0e0e0" BorderThickness="0,0,0,1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>  <!-- nexus mod / file -->
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- No checkbox for these entries -->
                                    <TextBlock Grid.Column="0" Text="—" Foreground="#cccccc"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Foreground="#222222"/>
                                        <TextBlock Text="{Binding PakFileName}"
                                                   FontSize="11" Foreground="#aaaaaa"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DisplayAuthor}"
                                               VerticalAlignment="Center" FontSize="11" Foreground="#666666"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>

                                    <!-- Nexus Mod name (top) + Nexus File name (bottom) -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#222222"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}"/>
                                        <TextBlock Text="{Binding NexusFileName}"
                                                   FontSize="11" Foreground="#aaaaaa"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding NexusFileName}"/>
                                    </StackPanel>

                                    <!-- Source: static Nexus badge -->
                                    <Border Grid.Column="4"
                                            Style="{StaticResource SourceBadgeBorder}"
                                            Background="#d98200"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Nexus" Style="{StaticResource SourceBadgeText}"/>
                                    </Border>

                                    <!-- Change identification button -->
                                    <Button Grid.Column="5"
                                            Content="Change"
                                            Command="{Binding ChangeCommand}"
                                            Width="70"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Reassign this mod to a different Nexus entry"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state (shown when both lists are empty) -->
                <TextBlock x:Name="EmptyText"
                           Text="No manually identified mods yet."
                           FontSize="11" Foreground="#aaaaaa"
                           HorizontalAlignment="Center"
                           Margin="0,24"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Toolbar -->
        <Border Grid.Row="3" Background="#f8f8f8" BorderBrush="#e0e0e0" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="Close" Click="Close_Click"
                    Width="80" Padding="0,5" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
