<Window x:Class="BG3ModHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BG3ModHelper.Views"
        Title="BG3 Mod Helper"
        Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <views:PathEllipsisConverter x:Key="PathEllipsisConverter"/>

        <Style x:Key="FolderLinkButton" TargetType="Button">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"                Value="0"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb"
                                   Text="{TemplateBinding Content}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{TemplateBinding ToolTip}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="tb" Property="Foreground"      Value="#0078d4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="tb" Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0078d4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106ebe"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Grid: content + drag overlay stacked -->
    <Grid>
        <!-- Main content -->
        <Grid x:Name="MainContent" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Info panel -->
                <RowDefinition Height="Auto"/>  <!-- Action buttons -->
                <RowDefinition Height="Auto"/>  <!-- Progress area -->
                <RowDefinition Height="*"/>     <!-- Recent activity -->
                <RowDefinition Height="Auto"/>  <!-- Bottom buttons -->
            </Grid.RowDefinitions>

            <!-- Info panel -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Grid Margin="0,4" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BG3MM folder:" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding BG3MMFolderPath}"
                            ToolTip="{Binding BG3MMFolderPath}"
                            Command="{Binding OpenBG3MMFolderCommand}"
                            Style="{StaticResource FolderLinkButton}"
                            VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Change..." Width="80" Padding="0,4"
                            Command="{Binding ChangeBG3MMFolderCommand}"/>
                </Grid>

                <Grid Margin="0,4" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BG3 Mods folder:" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding ModsFolderDisplay, Converter={StaticResource PathEllipsisConverter}}"
                            ToolTip="{Binding ModsFolderDisplay}"
                            Command="{Binding OpenModsFolderCommand}"
                            Style="{StaticResource FolderLinkButton}"
                            VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Installed mods:" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding InstalledModsCountDisplay}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4" MinHeight="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Last check:" FontWeight="SemiBold" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastCheckDisplay}"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Action buttons -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Check for Updates"
                        Height="44" FontSize="14" FontWeight="SemiBold"
                        Style="{StaticResource PrimaryActionButton}"
                        Command="{Binding CheckUpdatesCommand}"/>
                <Button Grid.Column="2" Content="Launch BG3MM"
                        Height="44" FontSize="14"
                        Command="{Binding LaunchBG3MMCommand}"/>
            </Grid>

            <!-- Progress area -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding StatusText}"
                           Foreground="#555555"
                           FontSize="11"
                           Margin="0,0,0,3"/>
                <ProgressBar Grid.Row="1"
                             Height="6"
                             Minimum="0"
                             Maximum="{Binding ProgressMax, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding ProgressIsIndeterminate, Mode=OneWay}"/>
            </Grid>

            <!-- Recent activity -->
            <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Recent Activity" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding RecentActivities}"
                             BorderThickness="0" Background="Transparent"/>
                </Grid>
            </Border>

            <!-- Bottom buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="History"  Width="68" Padding="0,4" Margin="0,0,8,0"
                        Command="{Binding OpenHistoryCommand}"/>
                <Button Content="Compact"  Width="68" Padding="0,4" Margin="0,0,8,0"
                        Command="{Binding EnterCompactCommand}"/>
                <Button Content="Settings" Width="68" Padding="0,4" Margin="0,0,8,0"
                        Command="{Binding OpenSettingsCommand}"/>
                <Button Content="Guide"    Width="68" Padding="0,4"
                        Command="{Binding OpenHelpCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Drag overlay — shown on DragEnter -->
        <Grid x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- Semi-transparent background -->
            <Rectangle Fill="#CC1a1a2e" RadiusX="0" RadiusY="0"/>
            <!-- Highlight border -->
            <Border BorderBrush="#0078d4" BorderThickness="4" Margin="4">
                <Border BorderBrush="#4da6ff" BorderThickness="1" Margin="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#x2B07;"
                                   FontSize="64" Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="Drop archive files here to install"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text=".zip  ·  .7z  ·  .rar  ·  .pak"
                                   FontSize="15" Foreground="#aaccff"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
