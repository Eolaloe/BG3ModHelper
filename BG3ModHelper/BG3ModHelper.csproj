<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyName>BG3ModHelper</AssemblyName>
		<RootNamespace>BG3ModHelper</RootNamespace>
		<Product>BG3 Mod Helper</Product>
		<Version>1.0.0</Version>
		<!-- LSLib.dll is x64-only. Match the target platform to avoid MSB3270. -->
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>

		<!-- Release / Publish settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishReadyToRun>true</PublishReadyToRun>

		<!-- Accept .NET 9+ runtime if .NET 8 is missing -->
		<RollForward>LatestMajor</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Assets\api_nexus.png"/>
		<Resource Include="Assets\api_modio.png"/>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\mod_download_button.png"/>
		<Resource Include="Assets\GitHub.png"/>
		<Resource Include="Assets\eola.png"/>
		<Resource Include="Assets\nexus.png"/>
		<Resource Include="Assets\nexus_grey.png"/>
		<Resource Include="Assets\modio.png"/>
		<Resource Include="Assets\bg3mm.ico"/>
		<Resource Include="Assets\bg3.png"/>
		<Resource Include="Assets\Discord.png"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="SharpCompress" Version="0.48.1" />
	</ItemGroup>

	<!--
	  LSLib bundled distribution.
	  LSLib.dll (managed) + native dependencies are included in the build output
	  and embedded into the single-file publish via IncludeNativeLibrariesForSelfExtract.

	  Files in Lib\:
	    LSLib.dll        — managed library (Norbyte, MIT license)
	    LSLibNative.dll  — native C++ companion
	    Ijwhost.dll      — C++/CLI interop host
	    LZ4.dll          — LZ4 compression (pak format)
	    LZ4pn.dll        — LZ4 portable native
	    ZstdSharp.dll    — Zstandard compression (patch 7+ pak format)
	-->
	<ItemGroup>
		<Reference Include="LSLib">
			<HintPath>Lib\LSLib.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Lib\LSLibNative.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Lib\Ijwhost.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Lib\LZ4.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Lib\LZ4pn.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Lib\ZstdSharp.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
