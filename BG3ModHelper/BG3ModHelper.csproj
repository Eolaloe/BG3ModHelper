<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AssemblyName>BG3ModHelper</AssemblyName>
		<RootNamespace>BG3ModHelper</RootNamespace>
		<Product>BG3 Mod Helper</Product>
		<Version>1.0.6.2</Version>
		<!-- LSLib.dll is x64-only. Match the target platform to avoid MSB3270. -->
		<PlatformTarget>x64</PlatformTarget>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>

		<!-- Release / Publish settings -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishReadyToRun>true</PublishReadyToRun>

		<!-- Accept .NET 9+ runtime if .NET 8 is missing -->
		<RollForward>LatestMajor</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Assets\api_nexus.png"/>
		<Resource Include="Assets\api_modio.png"/>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\mod_download_button.png"/>
		<Resource Include="Assets\GitHub.png"/>
		<Resource Include="Assets\eola.png"/>
		<Resource Include="Assets\nexus.png"/>
		<Resource Include="Assets\nexus_grey.png"/>
		<Resource Include="Assets\modio.png"/>
		<Resource Include="Assets\modio_grey.png"/>
		<Resource Include="Assets\bg3mm.ico"/>
		<Resource Include="Assets\bg3.png"/>
		<Resource Include="Assets\Discord.png"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="SharpCompress" Version="0.48.1" />
	</ItemGroup>

	<!--
	  LSLib: C++/CLI assembly — cannot be embedded in the single-file bundle
	  (.NET 8 limitation). Instead, all six DLLs are embedded as EmbeddedResources
	  and extracted to %LocalAppData%\BG3ModHelper\Lib\ on first run (or whenever
	  any file is missing). LibraryLoader loads them from that stable on-disk path.

	  Reference Private=false: compile-time only, not copied to build output.
	  LogicalName: resource is accessed by simple filename (e.g. "LSLib.dll").
	-->
	<ItemGroup>
		<Reference Include="LSLib">
			<HintPath>Lib\LSLib.dll</HintPath>
			<Private>false</Private>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Lib\LSLib.dll">          <LogicalName>LSLib.dll</LogicalName>          </EmbeddedResource>
		<EmbeddedResource Include="Lib\LSLibNative.dll">    <LogicalName>LSLibNative.dll</LogicalName>    </EmbeddedResource>
		<EmbeddedResource Include="Lib\Ijwhost.dll">        <LogicalName>Ijwhost.dll</LogicalName>        </EmbeddedResource>
		<EmbeddedResource Include="Lib\LZ4.dll">            <LogicalName>LZ4.dll</LogicalName>            </EmbeddedResource>
		<EmbeddedResource Include="Lib\LZ4pn.dll">          <LogicalName>LZ4pn.dll</LogicalName>          </EmbeddedResource>
		<EmbeddedResource Include="Lib\ZstdSharp.dll">      <LogicalName>ZstdSharp.dll</LogicalName>      </EmbeddedResource>
		<EmbeddedResource Include="Lib\WebView2Loader.dll"> <LogicalName>WebView2Loader.dll</LogicalName> </EmbeddedResource>
	</ItemGroup>

</Project>
